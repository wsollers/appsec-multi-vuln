{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "sourceMap": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "vite.config.ts"]
}
