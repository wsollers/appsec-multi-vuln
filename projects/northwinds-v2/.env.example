# Northwind application environment
NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/northwind.sqlite
AUTO_MIGRATE=true

# Browser and API settings
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ISSUER=https://northwind.example.com/
JWT_AUDIENCE=northwind-api
JWT_ACCESS_TTL_SECONDS=900
ENABLE_DEV_TOKEN_ENDPOINT=true

# Query and request settings
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
OUTBOUND_FETCH_ALLOWED_HOSTS=
