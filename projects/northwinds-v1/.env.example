# ---------------------------------------------------------------------------
# Northwind secure reference app — example environment configuration.
# Copy to `.env` and adjust for local development. NEVER commit a real `.env`.
# All values below are safe non-secret placeholders for local development only.
# ---------------------------------------------------------------------------

# Runtime profile: development | test | production
NODE_ENV=development

# HTTP server
PORT=4000
# Comma-separated exact allow-list of browser origins permitted to call the API
# with credentials. No wildcards. Reflecting arbitrary origins is not supported.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# JWT / OIDC verification
# ---------------------------------------------------------------------------
# Expected issuer and audience claims. Tokens whose iss/aud do not match are
# rejected. In a real deployment these point at your OAuth2/OIDC provider.
JWT_ISSUER=https://northwind.example.com/
JWT_AUDIENCE=northwind-api

# RS256 key pair (PEM). In development/test these may be left blank and an
# ephemeral key pair is generated at startup so the app is self-contained.
# In production you MUST supply keys from a secret manager — never commit them.
# Provide either inline PEM (with literal \n) or leave blank for ephemeral dev keys.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Access-token lifetime (seconds)
JWT_ACCESS_TTL_SECONDS=900

# Enable the development-only token mint endpoint (/api/v1/auth/dev/token).
# This stands in for an external IdP so the sample is runnable end to end.
# It is force-disabled when NODE_ENV=production regardless of this value.
ENABLE_DEV_TOKEN_ENDPOINT=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file path (kept outside any web root). ":memory:" is used in tests.
DATABASE_PATH=./data/northwind.sqlite
# Apply migrations automatically on startup (non-production convenience).
AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# GraphQL
# ---------------------------------------------------------------------------
# Max query depth and node/complexity budget. Introspection is auto-disabled
# in production regardless of profile.
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=1000

# ---------------------------------------------------------------------------
# Outbound fetch (SSRF guard)
# ---------------------------------------------------------------------------
# Comma-separated allow-list of hostnames the server may fetch on a user's
# behalf. Empty means outbound fetch is effectively disabled.
OUTBOUND_FETCH_ALLOWED_HOSTS=images.northwind.example.com

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
